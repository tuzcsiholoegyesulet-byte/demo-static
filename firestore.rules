rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Bárki olvashatja az adatokat (látogatók)
      allow read: if true;
      // Csak bejelentkezett adminisztrátorok írhatnak/módosíthatnak
      allow write: if request.auth != null;
    }
  }
}
