rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Bárki megtekintheti a képeket/fájlokat
      allow read: if true;
      // Csak bejelentkezett adminisztrátorok tölthetnek fel vagy törölhetnek
      allow write: if request.auth != null;
    }
  }
}
